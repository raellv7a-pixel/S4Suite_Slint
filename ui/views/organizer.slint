import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { PrimaryButton } from "../components/button.slint";

export struct ModTreeEntry {
    name: string,
    is_dir: bool,
    size_str: string,
    disabled: bool,
    path_str: string,
}

export component OrganizerView inherits Rectangle {
    in property <[ModTreeEntry]> mod_entries;
    in property <string> search_query: "";
    in property <string> selected_path: "";
    in property <string> organizer_status: "Pronto";
    in property <bool> show_duplicates_dialog: false;
    in property <string> duplicates_message: "";
    callback close_duplicates_dialog();


    callback search_changed(string);
    callback refresh_tree_clicked();
    callback check_scripts_clicked();
    callback find_duplicates_clicked();
    callback clean_junk_clicked();
    callback toggle_disabled_clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "📂 Organizador Global de Mods";
            font-size: 22px;
            font-weight: 800;
            color: Theme.text_primary;
        }

        // Toolbar Actions
        HorizontalLayout {
            spacing: 10px;

            PrimaryButton {
                text: "🔄 Recarregar";
                btn_color: Theme.surface_header;
                hover_color: Theme.surface_hover;
                clicked => { root.refresh_tree_clicked(); }
            }
            PrimaryButton {
                text: "⚠️ Checar Scripts";
                btn_color: Theme.surface_header;
                hover_color: Theme.surface_hover;
                clicked => { root.check_scripts_clicked(); }
            }
            PrimaryButton {
                text: "🔍 Duplicatas";
                btn_color: Theme.surface_header;
                hover_color: Theme.surface_hover;
                clicked => { root.find_duplicates_clicked(); }
            }
            PrimaryButton {
                text: "🧹 Limpar Lixo";
                btn_color: Theme.surface_header;
                hover_color: Theme.surface_hover;
                clicked => { root.clean_junk_clicked(); }
            }
            PrimaryButton {
                text: "🔴 Ligar/Desligar Mod";
                btn_color: Theme.primary_color;
                hover_color: Theme.primary_hover;
                clicked => { root.toggle_disabled_clicked(); }
            }
        }

        // File/Folder List
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;

                if root.mod_entries.length == 0 : Text {
                    text: "Nenhum mod encontrado na pasta Mods.";
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for entry in root.mod_entries : HorizontalLayout {
                    height: 36px;
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;

                    Text {
                        text: entry.is_dir ? "📁 " + entry.name : (entry.disabled ? "🔴 " + entry.name : "📦 " + entry.name);
                        font-size: 13px;
                        color: entry.disabled ? Theme.danger : Theme.text_primary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.size_str;
                        font-size: 12px;
                        color: Theme.text_secondary;
                        width: 100px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Status Bar
        Card {
            height: 36px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                Text { text: root.organizer_status; font-size: 12px; color: Theme.accent_color; vertical-alignment: center; }
            }
        }

        if root.show_duplicates_dialog : Rectangle {
            width: 100%; height: 100%;
            background: #000000.transparentize(0.4);
            TouchArea {}
            
            Card {
                width: 500px;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    Text { text: "🔍 Resultado da Busca por Duplicatas"; font-size: 18px; font-weight: 700; color: Theme.text_primary; }
                    Text { text: root.duplicates_message; font-size: 14px; color: Theme.text_secondary; wrap: word-wrap; }
                    PrimaryButton { text: "Fechar"; clicked => { root.close_duplicates_dialog(); } }
                }
            }
        }
    }
}
