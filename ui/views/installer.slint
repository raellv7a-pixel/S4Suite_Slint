import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { PrimaryButton } from "../components/button.slint";

export struct QueueItem {
    name: string,
    size_str: string,
    status: string,
}

export component InstallerView inherits Rectangle {
    in property <[QueueItem]> queue_items;
    in property <bool> is_installing: false;
    in property <string> install_status_text: "Arraste pacotes ou selecione arquivos abaixo.";

    callback select_files_clicked();
    callback start_install_clicked();
    callback clear_queue_clicked();
    in property <bool> show_careful_scan_dialog: false;
    in property <string> careful_scan_message: "";
    callback cancel_install_clicked();
    callback proceed_install_clicked();


    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Title
        Text {
            text: I18n.tr("📦 Smart Mod Installer V4");
            font-size: 22px;
            font-weight: 800;
            color: Theme.text_primary;
        }

        // Drop Zone / Select Card
        Card {
            height: 140px;
            border-color: Theme.primary_color;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: I18n.tr("📥 Arraste arquivos (.zip, .7z, .rar, .package, .ts4script) para esta área");
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text_primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: I18n.tr("O Smart Installer verifica segurança contra executáveis, resolve conflitos e cria backups de rollback.");
                    font-size: 12px;
                    color: Theme.text_secondary;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    PrimaryButton {
                        text: I18n.tr("📁 Selecionar Arquivos de Mods");
                        icon_str: "📁";
                        clicked => { root.select_files_clicked(); }
                    }
                }
            }
        }

        // Queue Header & Actions
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: I18n.tr("Fila de Instalação") + " (" + root.queue_items.length + ")";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text_primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            PrimaryButton {
                text: I18n.tr("🧹 Limpar Fila");
                btn_color: Theme.surface_header;
                hover_color: Theme.surface_hover;
                clicked => { root.clear_queue_clicked(); }
            }
            PrimaryButton {
                text: I18n.tr("⚡ Iniciar Instalação");
                enabled: root.queue_items.length > 0 && !root.is_installing;
                clicked => { root.start_install_clicked(); }
            }
        }

        // Queue Table
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;

                if root.queue_items.length == 0 : Text {
                    text: I18n.tr("Nenhum arquivo na fila de instalação.");
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for item in root.queue_items : HorizontalLayout {
                    height: 36px;
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Text { text: item.name; font-size: 13px; color: Theme.text_primary; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: item.size_str; font-size: 12px; color: Theme.text_secondary; width: 100px; vertical-alignment: center; }
                    Text { text: item.status; font-size: 12px; color: Theme.accent_color; width: 140px; vertical-alignment: center; }
                }
            }
        }

        // Status text
        Card {
            height: 40px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                Text {
                    text: root.install_status_text;
                    font-size: 13px;
                    color: Theme.info;
                    vertical-alignment: center;
                }
            }
        }
        
        if root.show_careful_scan_dialog : Rectangle {
            width: 100%; height: 100%;
            background: #000000.transparentize(0.4);
            TouchArea {}
            
            Card {
                width: 500px;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    Text { text: I18n.tr("⚠️ Scan Cuidadoso"); font-size: 18px; font-weight: 700; color: Theme.warning; }
                    Text { text: root.careful_scan_message; font-size: 14px; color: Theme.text_primary; wrap: word-wrap; }
                    
                    HorizontalLayout {
                        spacing: 12px;
                        PrimaryButton { text: I18n.tr("❌ Cancelar Instalação"); btn_color: Theme.surface_header; clicked => { root.cancel_install_clicked(); } }
                        PrimaryButton { text: I18n.tr("⚡ Prosseguir com Instalação"); btn_color: Theme.accent_color; clicked => { root.proceed_install_clicked(); } }
                    }
                }
            }
        }
    }
}
