import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { PrimaryButton } from "../components/button.slint";

export struct MergeQueueItem {
    name: string,
    size_str: string,
}

export component MergerView inherits Rectangle {
    in property <[MergeQueueItem]> items;
    in property <string> max_size_gb: "1.0";
    in property <bool> is_merging: false;
    in property <string> merge_status: "Aguardando seleção de arquivos...";
    in property <string> input_dir: "";
    in property <string> output_dir: "";
    /// 0.0 a 1.0. O merge lê centenas de packages: sem retorno visual a
    /// aplicação parece travada.
    in property <float> merge_progress: 0.0;

    callback select_input_clicked();
    callback select_output_clicked();
    callback start_merge_clicked();

    in property <bool> show_post_merge_dialog: false;
    in property <string> post_merge_message: "";
    callback post_merge_action(string); // "keep", "disable", "backup", "delete"

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text {
            text: "🔗 Unificador de Packages (Merger V2)";
            font-size: 22px;
            font-weight: 800;
            color: Theme.text_primary;
        }

        // Info Banner
        Card {
            height: 80px;
            HorizontalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: center;
                Text { text: "⚡"; font-size: 28px; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Merge de Alta Performance (DBPF Engine V2 em Rust)";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: "Unifica centenas de .package em partes organizadas com ordenação TGI para acelerar o jogo.";
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                }
            }
        }

        // Actions Bar
        HorizontalLayout {
            spacing: 12px;
            PrimaryButton {
                text: "📁 Selecionar Pasta de Origem";
                enabled: !root.is_merging;
                clicked => { root.select_input_clicked(); }
            }
            PrimaryButton {
                text: "📁 Selecionar Pasta de Destino";
                enabled: !root.is_merging;
                btn_color: Theme.surface_header;
                hover_color: Theme.surface_hover;
                clicked => { root.select_output_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            PrimaryButton {
                text: root.is_merging ? "⏳ Unificando..." : "🚀 Iniciar Unificação";
                // Sem origem e destino definidos não há merge possível.
                enabled: !root.is_merging && root.items.length > 0 && root.output_dir != "";
                btn_color: Theme.accent_color;
                clicked => { root.start_merge_clicked(); }
            }
        }

        // Origem / destino escolhidos
        HorizontalLayout {
            spacing: 16px;
            Text {
                text: "Origem: " + (root.input_dir == "" ? "não selecionada" : root.input_dir);
                font-size: 11px;
                color: Theme.text_muted;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: "Destino: " + (root.output_dir == "" ? "não selecionado" : root.output_dir);
                font-size: 11px;
                color: root.output_dir == "" ? Theme.warning : Theme.text_muted;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        // File List
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;

                if root.items.length == 0 : Text {
                    text: "Nenhum arquivo .package selecionado para merge.";
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for item in root.items : HorizontalLayout {
                    height: 36px;
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Text { text: "📦 " + item.name; font-size: 13px; color: Theme.text_primary; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: item.size_str; font-size: 12px; color: Theme.text_secondary; width: 100px; vertical-alignment: center; }
                }
            }
        }

        // Status Card
        Card {
            height: root.is_merging ? 56px : 40px;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                alignment: center;

                Text { text: root.merge_status; font-size: 13px; color: Theme.info; vertical-alignment: center; overflow: elide; }

                if root.is_merging : Rectangle {
                    height: 6px;
                    background: Theme.background;
                    border-radius: 3px;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.merge_progress;
                        height: parent.height;
                        background: Theme.accent_color;
                        border-radius: 3px;
                        animate width { duration: 150ms; }
                    }
                }
            }
        }
        
        if root.show_post_merge_dialog : Rectangle {
            width: 100%; height: 100%;
            background: #000000.transparentize(0.4);
            TouchArea {}

            Card {
                width: 500px;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    Text { text: "✅ Merge Concluído"; font-size: 18px; font-weight: 700; color: Theme.text_primary; }
                    Text { text: root.post_merge_message; font-size: 14px; color: Theme.text_secondary; wrap: word-wrap; }
                    Text { text: "O que deseja fazer com os arquivos originais?"; font-size: 14px; font-weight: 700; color: Theme.text_primary; }
                    
                    VerticalLayout {
                        spacing: 8px;
                        PrimaryButton { text: "Manter Originais (Recomendado para Testes)"; btn_color: Theme.surface_header; clicked => { root.post_merge_action("keep"); } }
                        PrimaryButton { text: "Desativar (.disabled)"; btn_color: Theme.warning; clicked => { root.post_merge_action("disable"); } }
                        PrimaryButton { text: "Mover para Backup (Zip)"; btn_color: Theme.info; clicked => { root.post_merge_action("backup"); } }
                        PrimaryButton { text: "Excluir Definitivamente"; btn_color: Theme.danger; clicked => { root.post_merge_action("delete"); } }
                    }
                }
            }
        }
    }
}
