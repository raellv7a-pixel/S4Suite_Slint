import { ListView, ScrollView, LineEdit } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { FilterChip } from "../components/chip.slint";
import { M3 } from "../theme/colors.slint";
import { Type, Shape, Space } from "../theme/typography.slint";
import { Dialog, DialogActions } from "../components/dialog.slint";
import { Icon, Ic } from "../components/icon.slint";
import { StatusBar } from "../components/status_bar.slint";
import { ViewHeader } from "../components/view_header.slint";

export struct MergeQueueItem {
    name: string,
    size_str: string,
}

/// Uma tarefa da fila: um grupo de packages com destino e pós-ação próprios.
export struct MergeJobItem {
    name: string,
    files_count: string,
    output_label: string,
    post_label: string,
    status_label: string,
    index: int,
    selected: bool,
}

export component MergerView inherits Rectangle {
    in property <[MergeQueueItem]> items;
    in property <[MergeJobItem]> jobs;
    in property <int> jobs_selected_count: 0;
    in property <string> post_action: "keep";

    callback add_job_clicked();
    callback remove_job_clicked();
    callback job_clicked(int);
    callback post_action_selected(string);
    callback start_queue_clicked();
    in property <string> max_size_gb: "1.0";
    in property <bool> is_merging: false;
    in property <string> merge_status: "Aguardando seleção de arquivos...";
    in property <string> input_dir: "";
    in property <string> output_dir: "";
    /// 0.0 a 1.0. O merge lê centenas de packages: sem retorno visual a
    /// aplicação parece travada.
    in property <float> merge_progress: 0.0;

    callback select_input_clicked();
    callback select_output_clicked();
    in property <bool> show_review: false;
    in property <string> review_title: "";
    in property <string> review_message: "";
    in property <[string]> review_items;
    in property <bool> review_requires_delete: false;
    in property <bool> review_has_risks: false;
    /// Incrementado por tarefa, inclusive quando nome, resumo e indícios são iguais.
    in property <int> review_revision: 0;
    callback confirm_review(int, string);
    callback cancel_review();

    property <string> delete_phrase: "";
    property <int> phrase_revision: -1;
    changed show_review => { root.delete_phrase = ""; }
    changed review_revision => { root.delete_phrase = ""; root.phrase_revision = -1; }
    changed review_title => { root.delete_phrase = ""; }
    changed review_message => { root.delete_phrase = ""; }
    changed review_items => { root.delete_phrase = ""; }
    changed review_requires_delete => { root.delete_phrase = ""; }

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        ViewHeader {
            icon_str: Ic.link;
            title: I18n.tr("Unificador de Packages (Merger V2)");
        }

        // Origem, destino e fila. A unificação em si é sempre pela fila: o caso comum é ter
        // vários grupos com destinos diferentes, e um botão "unificar agora" convidava a
        // processar um grupo de cada vez.
        HorizontalLayout {
            spacing: Space.md;
            Button {
                text: I18n.tr("Selecionar Pasta de Origem");
                icon_str: Ic.folder;
                enabled: !root.is_merging;
                clicked => { root.select_input_clicked(); }
            }
            Button {
                text: I18n.tr("Selecionar Pasta de Destino");
                icon_str: Ic.folder_open;
                enabled: !root.is_merging;
                clicked => { root.select_output_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: I18n.tr("Adicionar à Fila");
                icon_str: Ic.plus;
                enabled: !root.is_merging && root.items.length > 0 && root.output_dir != "";
                clicked => { root.add_job_clicked(); }
            }
            Button {
                text: root.is_merging ? I18n.tr("Unificando...") : I18n.tr("Executar Fila");
                icon_str: root.is_merging ? Ic.hourglass : Ic.play;
                kind: ButtonKind.filled;
                enabled: !root.is_merging && root.jobs.length > 0;
                clicked => { root.start_queue_clicked(); }
            }
        }

        // Actions Bar
        HorizontalLayout {
            spacing: 12px;
            Button {
                text: I18n.tr("Selecionar Pasta de Origem");
                icon_str: Ic.folder;
                enabled: !root.is_merging;
                clicked => { root.select_input_clicked(); }
            }
            Button {
                text: I18n.tr("Selecionar Pasta de Destino");
                icon_str: Ic.folder;
                enabled: !root.is_merging;
                clicked => { root.select_output_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                // Adicionar à fila em vez de unificar direto: o caso comum é ter
                // vários grupos com destinos diferentes.
                text: I18n.tr("Adicionar à Fila");
                icon_str: Ic.plus;
                enabled: !root.is_merging && root.items.length > 0 && root.output_dir != "";
                clicked => { root.add_job_clicked(); }
            }
            Button {
                kind: ButtonKind.filled;
                text: root.is_merging ? I18n.tr("Unificando...") : I18n.tr("Executar Fila");
                // Sem origem e destino definidos não há merge possível.
                enabled: !root.is_merging && root.jobs.length > 0;
                clicked => { root.start_queue_clicked(); }
            }
        }

        // Destino dos originais depois que a unificação der certo. Manter os
        // originais junto das partes duplica todo o conteúdo dentro do jogo.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: I18n.tr("Originais após unificar:");
                font-size: 12px;
                color: Theme.text_secondary;
                vertical-alignment: center;
            }
            for opcao in [
                { chave: "keep", rotulo: "Manter" },
                { chave: "disable", rotulo: "Desativar" },
                { chave: "backup", rotulo: "Backup em zip" },
                { chave: "delete", rotulo: "Excluir" },
            ] : FilterChip {
                // Escolha exclusiva: chip, não botão — o grupo precisa parecer um grupo.
                text: I18n.tr(opcao.rotulo);
                enabled: !root.is_merging;
                selected: root.post_action == opcao.chave;
                clicked => { root.post_action_selected(opcao.chave); }
            }
        }

        // Origem / destino escolhidos
        HorizontalLayout {
            spacing: 16px;
            Text {
                text: I18n.tr("Origem: ") + (root.input_dir == "" ? I18n.tr("não selecionada") : root.input_dir);
                font-size: 11px;
                color: Theme.text_muted;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: I18n.tr("Destino: ") + (root.output_dir == "" ? I18n.tr("não selecionado") : root.output_dir);
                font-size: 11px;
                color: root.output_dir == "" ? Theme.warning : Theme.text_muted;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            // Packages da origem atual, esperando virar uma tarefa.
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 12px;

                    Text {
                        text: I18n.tr("Origem atual");
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text_secondary;
                    }

                    if root.items.length == 0 : Text {
                        text: I18n.tr("Nenhum arquivo .package selecionado para merge.");
                        font-size: 13px;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }

                    // Apontar a origem para a própria pasta Mods traz milhares de packages de uma
                    // vez. Sem `ListView` todos viravam elementos reais na hora — a UI congelava —
                    // e ainda por cima o que passasse da altura do Card ficava sem rolagem.
                    if root.items.length > 0 : ListView {
                        vertical-stretch: 1;
                        for item in root.items : HorizontalLayout {
                            height: 32px;
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Icon { glyph: Ic.package; font-size: 14px; color: Theme.text_secondary; }
                            Text { text: item.name; font-size: 12px; color: Theme.text_primary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            Text { text: item.size_str; font-size: 11px; color: Theme.text_secondary; width: 90px; vertical-alignment: center; }
                        }
                    }
                }
            }

            // A fila propriamente dita.
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: I18n.tr("Fila de tarefas");
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text_secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            kind: ButtonKind.danger;
                            text: I18n.tr("Remover");
                            enabled: root.jobs_selected_count > 0 && !root.is_merging;
                            clicked => { root.remove_job_clicked(); }
                        }
                    }

                    if root.jobs.length == 0 : Text {
                        text: I18n.tr("Fila vazia. Escolha origem e destino e clique em Adicionar à Fila.");
                        font-size: 12px;
                        color: Theme.text_muted;
                        wrap: word-wrap;
                    }

                    for job in root.jobs : Rectangle {
                        height: 52px;
                        border-radius: 6px;
                        background: job.selected
                            ? Theme.primary_color.transparentize(0.7)
                            : (job_touch.has-hover ? Theme.surface_header : transparent);

                        job_touch := TouchArea {
                            enabled: !root.is_merging;
                            clicked => { root.job_clicked(job.index); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;

                            Icon {
                                glyph: job.selected ? Ic.checkbox_on : Ic.checkbox_off;
                                font-size: 13px;
                                color: job.selected ? Theme.accent_color : Theme.text_muted;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: job.name + " (" + job.files_count + ")";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: job.output_label + " · " + job.post_label;
                                    font-size: 11px;
                                    color: Theme.text_muted;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: job.status_label;
                                font-size: 11px;
                                color: Theme.accent_color;
                                width: 90px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Status Card
        Card {
            height: root.is_merging ? 56px : 40px;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                alignment: center;

                StatusBar { text: root.merge_status; }

                if root.is_merging : Rectangle {
                    height: 6px;
                    background: Theme.background;
                    border-radius: 3px;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.merge_progress;
                        height: parent.height;
                        background: Theme.accent_color;
                        border-radius: 3px;
                        animate width { duration: 150ms; }
                    }
                }
            }
        }
        
    }

    Dialog {
        open: root.show_review;
        title: root.review_title;
        icon_str: Ic.warning;
        title_color: root.review_requires_delete ? M3.error : M3.warning;
        panel_width: 640px;
        dismissed => { root.cancel_review(); }

        Text {
            text: root.review_message;
            font-size: Type.body_m;
            color: M3.on_surface;
            wrap: word-wrap;
        }
        if root.review_has_risks : Text {
            text: I18n.tr("Os nomes e caminhos abaixo são indícios heurísticos, não incompatibilidades comprovadas. A autorização vale somente para esta tarefa.");
            font-size: Type.body_s;
            color: M3.on_surface_variant;
            wrap: word-wrap;
        }

        if root.show_review && root.review_items.length > 0 : Rectangle {
            height: min(180px, root.height / 4);
            background: M3.surface_container_lowest;
            border-radius: Shape.sm;
            ScrollView {
                VerticalLayout {
                    padding: Space.sm;
                    spacing: Space.sm;
                    alignment: start;
                    // Sem elisão: caminhos longos continuam acessíveis pela rolagem horizontal.
                    for item in root.review_items : Text {
                        text: item;
                        font-size: Type.body_s;
                        color: M3.on_surface_variant;
                    }
                }
            }
        }
        if !root.review_has_risks : Text {
            text: I18n.tr("Nenhum indício foi encontrado. Isso não garante compatibilidade; revise a origem, o destino e a pós-ação antes de prosseguir.");
            font-size: Type.body_s;
            color: M3.on_surface_variant;
            wrap: word-wrap;
        }

        if root.review_requires_delete : Text {
            text: I18n.tr("A exclusão dos originais após a unificação é permanente. Não será criado um backup por esta pós-ação.");
            font-size: Type.body_m;
            font-weight: Type.title_s_w;
            color: M3.error;
            wrap: word-wrap;
        }
        if root.review_requires_delete : Text {
            text: I18n.tr("Para autorizar esta tarefa, digite exatamente:") + " EXCLUIR ORIGINAIS";
            font-size: Type.body_s;
            color: M3.on_surface;
            wrap: word-wrap;
        }
        if root.review_requires_delete : LineEdit {
            placeholder-text: "EXCLUIR ORIGINAIS";
            text <=> root.delete_phrase;
            enabled: root.show_review;
            edited => { root.phrase_revision = root.review_revision; }
        }

        DialogActions {
            Button {
                text: I18n.tr("Cancelar");
                kind: ButtonKind.text;
                enabled: root.show_review;
                clicked => { root.cancel_review(); }
            }
            Button {
                text: root.review_requires_delete
                    ? I18n.tr("Prosseguir e excluir originais")
                    : I18n.tr("Prosseguir com esta tarefa");
                icon_str: root.review_requires_delete ? Ic.trash : Ic.check_circle;
                kind: root.review_requires_delete ? ButtonKind.danger : ButtonKind.filled;
                enabled: root.show_review && (!root.review_requires_delete || (root.delete_phrase == "EXCLUIR ORIGINAIS" && root.phrase_revision == root.review_revision));
                clicked => { root.confirm_review(root.review_requires_delete ? root.phrase_revision : root.review_revision, root.delete_phrase); }
            }
        }
    }
}
