import { I18n } from "../i18n.slint";
import { M3 } from "../theme/colors.slint";
import { Type, Shape, Space } from "../theme/typography.slint";
import { Card, CardKind } from "../components/card.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { FilterChip } from "../components/chip.slint";
import { Icon, Ic } from "../components/icon.slint";
import { ViewHeader } from "../components/view_header.slint";
import { StatusBar } from "../components/status_bar.slint";

export component ConfigView inherits Rectangle {
    in property <string> game_path: "";
    in property <string> merge_limit_gb: "1.0";
    in property <string> active_language: "Português";
    in property <int> active_theme_idx: 0;
    in property <bool> system_theme_available: false;
    in property <string> config_status: "Pronto";

    callback select_game_path_clicked();
    callback autodetect_game_path_clicked();
    callback save_config_clicked();
    /// "pt" | "en" | "es"
    callback language_selected(string);
    callback theme_selected(int);
    /// Limite de tamanho por parte gerada pelo merger, em GB.
    callback merge_limit_selected(string);

    // "1" e "1.0" são o mesmo limite: o Rust formata o f64 sem casa decimal quando ela é zero.
    function limite_ativo(gb: string) -> bool {
        return root.merge_limit_gb == gb || root.merge_limit_gb + ".0" == gb;
    }

    VerticalLayout {
        padding: Space.xxl;
        spacing: Space.lg;

        ViewHeader {
            icon_str: Ic.settings;
            title: I18n.tr("Configurações do Aplicativo");
        }

        // Pasta do jogo
        Card {
            kind: CardKind.outlined;
            VerticalLayout {
                padding: Space.xl;
                spacing: Space.md;

                Text {
                    text: I18n.tr("Pasta Raiz do The Sims 4 (Game/Bin)");
                    font-size: Type.title_m;
                    font-weight: Type.title_m_w;
                    color: M3.on_surface;
                }

                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        text: root.game_path != "" ? root.game_path : I18n.tr("Não configurada");
                        font-size: Type.body_m;
                        color: M3.on_surface_variant;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button {
                        text: I18n.tr("Procurar");
                        icon_str: Ic.folder;
                        kind: ButtonKind.outlined;
                        clicked => { root.select_game_path_clicked(); }
                    }
                    Button {
                        text: I18n.tr("Auto-Detectar");
                        icon_str: Ic.target;
                        kind: ButtonKind.filled;
                        clicked => { root.autodetect_game_path_clicked(); }
                    }
                }
            }
        }

        // Aparência e idioma
        Card {
            kind: CardKind.outlined;
            VerticalLayout {
                padding: Space.xl;
                spacing: Space.lg;

                Text {
                    text: I18n.tr("Personalização Visual & Idioma");
                    font-size: Type.title_m;
                    font-weight: Type.title_m_w;
                    color: M3.on_surface;
                }

                VerticalLayout {
                    spacing: Space.sm;
                    Text {
                        text: I18n.tr("Tema Visual:");
                        font-size: Type.body_s;
                        color: M3.on_surface_variant;
                    }
                    HorizontalLayout {
                        spacing: Space.sm;
                        FilterChip {
                            text: I18n.tr("Sims Green");
                            swatch: #4ade80;
                            selected: root.active_theme_idx == 0;
                            clicked => { root.theme_selected(0); }
                        }
                        FilterChip {
                            text: I18n.tr("Deep Blue");
                            swatch: #93b4ff;
                            selected: root.active_theme_idx == 1;
                            clicked => { root.theme_selected(1); }
                        }
                        FilterChip {
                            text: I18n.tr("Cyber Purple");
                            swatch: #d8b4fe;
                            selected: root.active_theme_idx == 2;
                            clicked => { root.theme_selected(2); }
                        }
                        FilterChip {
                            text: I18n.tr("Neon Pink");
                            swatch: #ffb1c8;
                            selected: root.active_theme_idx == 3;
                            clicked => { root.theme_selected(3); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    // O chip fica visível mesmo sem a shell instalada, só desabilitado: escondê-lo
                    // faria o recurso passar despercebido por quem ainda vai instalar a shell.
                    HorizontalLayout {
                        spacing: Space.md;
                        FilterChip {
                            text: I18n.tr("Sistema (Hydra Shell)");
                            icon_str: Ic.palette;
                            enabled: root.system_theme_available;
                            selected: root.active_theme_idx == 4;
                            clicked => { root.theme_selected(4); }
                        }
                        Text {
                            text: root.system_theme_available
                                ? I18n.tr("As cores acompanham o tema do desktop em tempo real.")
                                : I18n.tr("Hydra Shell não encontrada em ~/.config.");
                            font-size: Type.label_s;
                            color: M3.outline;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                    }
                }

                // Idioma: a troca é imediata, sem reiniciar — os bindings que
                // chamam I18n.tr dependem de I18n.lang e reavaliam sozinhos.
                VerticalLayout {
                    spacing: Space.sm;
                    Text {
                        text: I18n.tr("Idioma:");
                        font-size: Type.body_s;
                        color: M3.on_surface_variant;
                    }
                    HorizontalLayout {
                        spacing: Space.sm;
                        FilterChip {
                            text: "Português";
                            selected: root.active_language == "pt";
                            clicked => { root.language_selected("pt"); }
                        }
                        FilterChip {
                            text: "English";
                            selected: root.active_language == "en";
                            clicked => { root.language_selected("en"); }
                        }
                        FilterChip {
                            text: "Español";
                            selected: root.active_language == "es";
                            clicked => { root.language_selected("es"); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        // Limite do merger
        Card {
            kind: CardKind.outlined;
            VerticalLayout {
                padding: Space.xl;
                spacing: Space.md;

                Text {
                    text: I18n.tr("Limite de Tamanho por Parte (Merger)");
                    font-size: Type.title_m;
                    font-weight: Type.title_m_w;
                    color: M3.on_surface;
                }
                Text {
                    text: I18n.tr("Packages muito grandes podem travar o carregamento do jogo. 1 GB é o valor seguro para a maioria dos casos.");
                    font-size: Type.body_s;
                    color: M3.outline;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Space.sm;
                    FilterChip {
                        text: "0.5 GB";
                        selected: root.limite_ativo("0.5");
                        clicked => { root.merge_limit_selected("0.5"); }
                    }
                    FilterChip {
                        text: "1.0 GB";
                        selected: root.limite_ativo("1.0");
                        clicked => { root.merge_limit_selected("1.0"); }
                    }
                    FilterChip {
                        text: "2.0 GB";
                        selected: root.limite_ativo("2.0");
                        clicked => { root.merge_limit_selected("2.0"); }
                    }
                    FilterChip {
                        text: "4.0 GB";
                        selected: root.limite_ativo("4.0");
                        clicked => { root.merge_limit_selected("4.0"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        HorizontalLayout {
            spacing: Space.md;
            Button {
                text: I18n.tr("Salvar Configurações");
                icon_str: Ic.save;
                kind: ButtonKind.filled;
                clicked => { root.save_config_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        StatusBar { text: root.config_status; }

        Rectangle { vertical-stretch: 1; }
    }
}
