import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { Type, Space } from "../theme/typography.slint";
import { Icon, Ic } from "../components/icon.slint";
import { StatusBar } from "../components/status_bar.slint";
import { ViewHeader } from "../components/view_header.slint";

export struct TranslationItem {
    name: string,
    size_str: string,
}

export component TranslationsView inherits Rectangle {
    in property <[TranslationItem]> installed_translations;
    in property <string> status_text: "Pronto";

    callback select_translation_clicked();
    callback delete_translation_clicked(string);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        ViewHeader {
            icon_str: Ic.language;
            title: I18n.tr("Gerenciador de Traduções (01_Traducoes)");
        }

        HorizontalLayout {
            spacing: Space.md;
            Button {
                text: I18n.tr("Instalar / Atualizar Tradução");
                icon_str: Ic.download;
                kind: ButtonKind.filled;
                clicked => { root.select_translation_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;

                if root.installed_translations.length == 0 : Text {
                    text: I18n.tr("Nenhuma tradução instalada na pasta 01_Traducoes.");
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for item in root.installed_translations : HorizontalLayout {
                    height: 40px;
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Icon { glyph: Ic.language; font-size: 16px; color: Theme.accent_color; }
                    Text { text: item.name; font-size: 13px; color: Theme.text_primary; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: item.size_str; font-size: 12px; color: Theme.text_secondary; width: 100px; vertical-alignment: center; }
                    Button {
                        kind: ButtonKind.danger;
                        text: I18n.tr("Excluir");
                        icon_str: Ic.trash;
                        clicked => { root.delete_translation_clicked(item.name); }
                    }
                }
            }
        }

        StatusBar { text: root.status_text; }
    }
}
