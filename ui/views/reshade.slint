import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";
import { Card, CardKind } from "../components/card.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { M3 } from "../theme/colors.slint";
import { Type, Space } from "../theme/typography.slint";
import { Icon, Ic } from "../components/icon.slint";
import { StatusBar } from "../components/status_bar.slint";
import { ViewHeader } from "../components/view_header.slint";

export component ReshadeView inherits Rectangle {
    in property <string> env_type: "GENERIC";
    in property <string> env_command: "WINEDLLOVERRIDES=\"dxgi=n,b\" %command%";
    in property <bool> is_installed: false;
    /// DLL usada como proxy: "dxgi.dll", "d3d11.dll"...
    in property <string> injected_dll: "";
    in property <string> presets_count: "0";
    /// Download + injeção em andamento.
    in property <bool> is_busy: false;
    in property <string> reshade_status: "Aguardando ação...";

    callback install_reshade_clicked();
    callback uninstall_reshade_clicked();
    callback install_preset_clicked();
    callback copy_command_clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        ViewHeader {
            icon_str: Ic.sparkles;
            title: I18n.tr("Gerenciador ReShade (Linux Edition)");
        }

        // Ambiente detectado e a variável que o usuário precisa colar no Steam. É o dado que
        // ele veio buscar; fica acima das ações.
        Card {
            kind: CardKind.outlined;
            VerticalLayout {
                padding: Space.lg;
                spacing: Space.sm;

                HorizontalLayout {
                    spacing: Space.sm;
                    Icon { glyph: Ic.desktop; font-size: 16px; color: M3.on_surface_variant; }
                    Text {
                        text: I18n.tr("Ambiente detectado:");
                        font-size: Type.body_m;
                        font-weight: 600;
                        color: M3.on_surface_variant;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.env_type;
                        font-size: Type.body_m;
                        font-weight: 800;
                        color: M3.primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: center;
                    Text {
                        text: root.env_command;
                        font-size: Type.body_s;
                        font-weight: 600;
                        color: M3.info;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button {
                        text: I18n.tr("Copiar Comando");
                        icon_str: Ic.clipboard;
                        kind: ButtonKind.outlined;
                        clicked => { root.copy_command_clicked(); }
                    }
                }
            }
        }

        // Action Buttons
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: I18n.tr("Injeção e Gerenciamento DX11");
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text_primary;
                }

                // Estado real lido do disco, não do manifesto: o usuário pode
                // ter instalado o ReShade por fora ou apagado a DLL na mão.
                HorizontalLayout {
                    spacing: 8px;
                    Icon {
                        glyph: Ic.circle_dot;
                        font-size: 14px;
                        color: root.is_installed ? Theme.success : Theme.text_muted;
                    }
                    Text {
                        text: root.is_installed
                            ? I18n.tr("ReShade instalado") + " (" + root.injected_dll + ")"
                            : I18n.tr("ReShade não instalado");
                        font-size: 13px;
                        font-weight: 600;
                        color: root.is_installed ? Theme.success : Theme.text_muted;
                        vertical-alignment: center;
                    }
                    if root.is_installed : Text {
                        text: "·  " + root.presets_count + " " + I18n.tr("preset(s)");
                        font-size: 13px;
                        color: Theme.text_secondary;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Button {
                        kind: ButtonKind.filled;
                        text: root.is_busy
                            ? I18n.tr("Baixando e injetando...")
                            : (root.is_installed
                                ? I18n.tr("Reinstalar ReShade (5.9.2)")
                                : I18n.tr("Instalar ReShade (5.9.2 Stable)"));
                        icon_str: Ic.wand;
                        enabled: !root.is_busy;
                        clicked => { root.install_reshade_clicked(); }
                    }
                    Button {
                        text: I18n.tr("Instalar Preset (.zip)");
                        icon_str: Ic.package;
                        // Preset sem ReShade instalado não tem o que carregar.
                        enabled: root.is_installed && !root.is_busy;
                        clicked => { root.install_preset_clicked(); }
                    }
                    Button {
                        kind: ButtonKind.danger;
                        text: I18n.tr("Desinstalar ReShade");
                        icon_str: Ic.trash;
                        enabled: root.is_installed && !root.is_busy;
                        clicked => { root.uninstall_reshade_clicked(); }
                    }
                }
            }
        }

        StatusBar { text: root.reshade_status; }

        Rectangle { vertical-stretch: 1; }
    }
}
