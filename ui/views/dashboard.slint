import { I18n } from "../i18n.slint";
import { ScrollView } from "std-widgets.slint";
import { M3 } from "../theme/colors.slint";
import { Type, Shape, Space } from "../theme/typography.slint";
import { Theme } from "../palette.slint";
import { Card, CardKind } from "../components/card.slint";
import { StatCard } from "../components/stat_card.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { Icon, Ic } from "../components/icon.slint";
import { StatusBar } from "../components/status_bar.slint";
import { Dialog, DialogActions } from "../components/dialog.slint";

export component DashboardView inherits Rectangle {
    in property <string> game_path: "Não configurado";
    in property <string> total_mods_count: "0";
    in property <string> total_scripts_count: "0";
    in property <string> total_mods_size: "0 MB";
    in property <string> total_tray_count: "0";
    in property <string> status_message: "Pronto";

    callback clear_cache_clicked();
    callback backup_saves_clicked();
    callback refresh_stats_clicked();

    // Detalhes por trás dos números. Um card que só mostra "1.238 mods" não
    // ajuda quem quer saber *onde* está o peso.
    in property <[string]> folder_size_details;
    in property <[string]> scripts_details;
    in property <[string]> tray_details;
    property <string> open_details: "";
    property <string> details_title: "";

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // Welcome Header
        Card {
            height: 100px;
            HorizontalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: center;

                Icon {
                    glyph: Ic.confetti;
                    font-size: 34px;
                    color: Theme.accent_color;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: I18n.tr("Bem-vindo ao S4 Suite v2.0 (Linux Edition)");
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: I18n.tr("O Seu Hub Definitivo para Mods e Conteúdos do The Sims 4 no Linux");
                        font-size: 13px;
                        color: Theme.text_secondary;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Métricas. `has_details` liga a affordance: só três dos quatro números têm lista por trás.
        HorizontalLayout {
            spacing: Space.lg;
            vertical-stretch: 0;

            StatCard {
                label: I18n.tr("Mods Instalados");
                value: root.total_mods_count;
                icon_str: Ic.package;
                accent: M3.primary;
            }
            StatCard {
                label: I18n.tr("Scripts (.ts4script)");
                value: root.total_scripts_count;
                icon_str: Ic.file_text;
                accent: M3.info;
                has_details: true;
                hint: I18n.tr("clique para ver a lista");
                clicked => {
                    root.details_title = I18n.tr("Caminhos dos Scripts");
                    root.open_details = "scripts";
                }
            }
            StatCard {
                label: I18n.tr("Tamanho Ocupado");
                value: root.total_mods_size;
                icon_str: Ic.stack;
                accent: M3.warning;
                has_details: true;
                hint: I18n.tr("clique para ver a lista");
                clicked => {
                    root.details_title = I18n.tr("Tamanho Ocupado por Pasta");
                    root.open_details = "folders";
                }
            }
            StatCard {
                label: I18n.tr("Arquivos Tray");
                value: root.total_tray_count;
                icon_str: Ic.inbox;
                accent: M3.tertiary;
                has_details: true;
                hint: I18n.tr("clique para ver a lista");
                clicked => {
                    root.details_title = I18n.tr("Arquivos do Tray");
                    root.open_details = "tray";
                }
            }
        }

        // Ações rápidas
        Card {
            VerticalLayout {
                padding: Space.xl;
                spacing: Space.lg;

                Text {
                    text: I18n.tr("Ações Rápidas");
                    font-size: Type.title_m;
                    font-weight: Type.title_m_w;
                    color: M3.on_surface;
                }

                HorizontalLayout {
                    spacing: Space.md;
                    Button {
                        text: I18n.tr("Limpar Cache do Jogo");
                        icon_str: Ic.brush;
                        clicked => { root.clear_cache_clicked(); }
                    }
                    Button {
                        text: I18n.tr("Backup de Saves");
                        icon_str: Ic.shield;
                        clicked => { root.backup_saves_clicked(); }
                    }
                    Button {
                        text: I18n.tr("Atualizar Estatísticas");
                        icon_str: Ic.refresh;
                        kind: ButtonKind.filled;
                        clicked => { root.refresh_stats_clicked(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // Caminho do jogo e status
        Card {
            kind: CardKind.outlined;
            VerticalLayout {
                padding: Space.lg;
                spacing: Space.sm;

                HorizontalLayout {
                    spacing: Space.sm;
                    Icon { glyph: Ic.pin; font-size: 15px; color: M3.on_surface_variant; }
                    Text {
                        text: I18n.tr("Caminho do Jogo:");
                        font-size: Type.body_m;
                        font-weight: 600;
                        color: M3.on_surface_variant;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.game_path;
                        font-size: Type.body_m;
                        color: M3.on_surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }

        StatusBar { text: root.status_message; }

        Rectangle { vertical-stretch: 1; }

    }

    // Detalhe do card clicado. As listas já vêm prontas do Rust: montá-las aqui percorreria
    // milhares de caminhos dentro da thread da UI — por isso cada uma continua sob o seu `if`,
    // como o `Dialog` exige de conteúdo pesado.
    Dialog {
        open: root.open_details != "";
        title: root.details_title;
        icon_str: Ic.list;
        panel_width: 620px;
        dismissed => { root.open_details = ""; }

        Rectangle {
            height: 340px;
            background: M3.surface_container_lowest;
            border-radius: Shape.sm;
            ScrollView {
                VerticalLayout {
                    padding: Space.sm;
                    alignment: start;

                    if root.open_details == "folders" : VerticalLayout {
                        for linha in root.folder_size_details : Text {
                            text: linha;
                            font-size: Type.body_s;
                            color: M3.on_surface_variant;
                            overflow: elide;
                        }
                    }
                    if root.open_details == "scripts" : VerticalLayout {
                        for linha in root.scripts_details : Text {
                            text: linha;
                            font-size: Type.body_s;
                            color: M3.on_surface_variant;
                            overflow: elide;
                        }
                    }
                    if root.open_details == "tray" : VerticalLayout {
                        for linha in root.tray_details : Text {
                            text: linha;
                            font-size: Type.body_s;
                            color: M3.on_surface_variant;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        DialogActions {
            Button {
                text: I18n.tr("Fechar");
                kind: ButtonKind.text;
                clicked => { root.open_details = ""; }
            }
        }
    }
}
