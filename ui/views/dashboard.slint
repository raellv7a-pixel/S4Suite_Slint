import { I18n } from "../i18n.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { PrimaryButton } from "../components/button.slint";

export component DashboardView inherits Rectangle {
    in property <string> game_path: "Não configurado";
    in property <string> total_mods_count: "0";
    in property <string> total_scripts_count: "0";
    in property <string> total_mods_size: "0 MB";
    in property <string> total_tray_count: "0";
    in property <string> status_message: "Pronto";

    callback clear_cache_clicked();
    callback backup_saves_clicked();
    callback refresh_stats_clicked();

    // Detalhes por trás dos números. Um card que só mostra "1.238 mods" não
    // ajuda quem quer saber *onde* está o peso.
    in property <[string]> folder_size_details;
    in property <[string]> scripts_details;
    in property <[string]> tray_details;
    property <string> open_details: "";
    property <string> details_title: "";

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // Welcome Header
        Card {
            height: 100px;
            HorizontalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: center;

                Text {
                    text: "🎉";
                    font-size: 36px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: I18n.tr("Bem-vindo ao S4 Suite v2.0 (Linux Edition)");
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: I18n.tr("O Seu Hub Definitivo para Mods e Conteúdos do The Sims 4 no Linux");
                        font-size: 13px;
                        color: Theme.text_secondary;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Stats Grid
        HorizontalLayout {
            spacing: 16px;

            Card {
                horizontal-stretch: 1;
                height: 110px;
                VerticalLayout {
                    padding: 16px;
                    alignment: space-between;
                    Text { text: I18n.tr("📦 Mods Instalados"); font-size: 13px; color: Theme.text_secondary; }
                    Text { text: root.total_mods_count; font-size: 28px; font-weight: 800; color: Theme.accent_color; }
                }
            }
            Card {
                horizontal-stretch: 1;
                height: 110px;
                scripts_touch := TouchArea {
                    clicked => {
                        root.details_title = I18n.tr("📜 Caminhos dos Scripts");
                        root.open_details = "scripts";
                    }
                }
                VerticalLayout {
                    padding: 16px;
                    alignment: space-between;
                    Text { text: I18n.tr("📜 Scripts (.ts4script)"); font-size: 13px; color: Theme.text_secondary; }
                    Text { text: root.total_scripts_count; font-size: 28px; font-weight: 800; color: Theme.info; }
                    Text {
                        text: scripts_touch.has-hover ? I18n.tr("clique para ver a lista") : "";
                        font-size: 10px;
                        color: Theme.text_muted;
                    }
                }
            }
            Card {
                horizontal-stretch: 1;
                height: 110px;
                size_touch := TouchArea {
                    clicked => {
                        root.details_title = I18n.tr("💾 Tamanho Ocupado por Pasta");
                        root.open_details = "folders";
                    }
                }
                VerticalLayout {
                    padding: 16px;
                    alignment: space-between;
                    Text { text: I18n.tr("💾 Tamanho Ocupado"); font-size: 13px; color: Theme.text_secondary; }
                    Text { text: root.total_mods_size; font-size: 28px; font-weight: 800; color: Theme.warning; }
                    Text {
                        text: size_touch.has-hover ? I18n.tr("clique para ver a lista") : "";
                        font-size: 10px;
                        color: Theme.text_muted;
                    }
                }
            }
            Card {
                horizontal-stretch: 1;
                height: 110px;
                tray_touch := TouchArea {
                    clicked => {
                        root.details_title = I18n.tr("🗂️ Arquivos do Tray");
                        root.open_details = "tray";
                    }
                }
                VerticalLayout {
                    padding: 16px;
                    alignment: space-between;
                    Text { text: I18n.tr("🗂️ Arquivos Tray"); font-size: 13px; color: Theme.text_secondary; }
                    Text { text: root.total_tray_count; font-size: 28px; font-weight: 800; color: Theme.success; }
                    Text {
                        text: tray_touch.has-hover ? I18n.tr("clique para ver a lista") : "";
                        font-size: 10px;
                        color: Theme.text_muted;
                    }
                }
            }
        }

        // Quick Actions
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: I18n.tr("⚡ Ações Rápidas");
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text_primary;
                }

                HorizontalLayout {
                    spacing: 12px;
                    PrimaryButton {
                        text: I18n.tr("🧹 Limpar Cache do Jogo");
                        icon_str: "🧹";
                        btn_color: Theme.surface_header;
                        hover_color: Theme.surface_hover;
                        clicked => { root.clear_cache_clicked(); }
                    }
                    PrimaryButton {
                        text: I18n.tr("🛡️ Backup de Saves");
                        icon_str: "🛡️";
                        btn_color: Theme.surface_header;
                        hover_color: Theme.surface_hover;
                        clicked => { root.backup_saves_clicked(); }
                    }
                    PrimaryButton {
                        text: I18n.tr("🔄 Atualizar Estatísticas");
                        icon_str: "🔄";
                        btn_color: Theme.primary_color;
                        hover_color: Theme.primary_hover;
                        clicked => { root.refresh_stats_clicked(); }
                    }
                }
            }
        }

        // Path & Status Banner
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    Text { text: I18n.tr("📍 Caminho do Jogo: "); font-size: 13px; font-weight: 600; color: Theme.text_secondary; }
                    Text { text: root.game_path; font-size: 13px; color: Theme.text_primary; }
                }
                HorizontalLayout {
                    Text { text: I18n.tr("ℹ️ Status: "); font-size: 13px; font-weight: 600; color: Theme.text_secondary; }
                    Text { text: root.status_message; font-size: 13px; color: Theme.accent_color; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        // Detalhe do card clicado. A lista já vem pronta do Rust: montá-la aqui
        // percorreria milhares de caminhos dentro da thread da UI.
        if root.open_details != "" : Rectangle {
            width: 100%; height: 100%;
            background: #000000.transparentize(0.4);
            TouchArea {}

            Card {
                width: 620px;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    Text {
                        text: root.details_title;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    Rectangle {
                        height: 340px;
                        background: Theme.background;
                        border-radius: 6px;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                alignment: start;

                                if root.open_details == "folders" : VerticalLayout {
                                    for linha in root.folder_size_details : Text {
                                        text: linha;
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                    }
                                }
                                if root.open_details == "scripts" : VerticalLayout {
                                    for linha in root.scripts_details : Text {
                                        text: "📜 " + linha;
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                    }
                                }
                                if root.open_details == "tray" : VerticalLayout {
                                    for linha in root.tray_details : Text {
                                        text: "🗂️ " + linha;
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    PrimaryButton {
                        text: I18n.tr("Fechar");
                        btn_color: Theme.surface_header;
                        hover_color: Theme.surface_hover;
                        clicked => { root.open_details = ""; }
                    }
                }
            }
        }
    }
}
