import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { M3 } from "../theme/colors.slint";
import { Type, Space } from "../theme/typography.slint";
import { OverflowMenu } from "../components/overflow_menu.slint";
import { Icon, Ic } from "../components/icon.slint";
import { StatusBar } from "../components/status_bar.slint";
import { ViewHeader } from "../components/view_header.slint";

export struct TrayItem {
    name: string,
    type_str: string,
    files_count: string,
    /// Para onde vai o CC deste item, relativo a Mods.
    cc_target_label: string,
    skipped: bool,
    selected: bool,
    index: int,
}

export component TrayView inherits Rectangle {
    in property <[TrayItem]> tray_items;
    in property <bool> is_importing: false;
    in property <string> tray_status: "Arraste zips de Sims/Lotes ou selecione arquivos para importar.";
    in property <int> tray_selected_count: 0;

    callback select_tray_files_clicked();
    callback start_import_clicked();
    callback tray_item_clicked(int);
    callback set_destination_selected();
    callback set_destination_all();
    callback skip_selected_clicked();
    callback clear_queue_clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        ViewHeader {
            icon_str: Ic.inbox;
            title: I18n.tr("Importador de Sims e Lotes (Tray Importer V3)");
        }

        HorizontalLayout {
            spacing: Space.md;
            Button {
                text: I18n.tr("Selecionar Zips / Arquivos Tray");
                icon_str: Ic.folder;
                enabled: !root.is_importing;
                clicked => { root.select_tray_files_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            // Ações por item da fila ficam no menu: cada Sim ou Lote pode ter seu próprio destino
            // de CC, mas isso é ajuste fino — quem importa pela primeira vez só quer o botão azul.
            OverflowMenu {
                actions: [
                    { id: "cc_sel", label: I18n.tr("Destino do CC (selecionados)"), glyph: Ic.folder_open, enabled: root.tray_selected_count > 0 && !root.is_importing },
                    { id: "cc_all", label: I18n.tr("Destino do CC (todos)"), glyph: Ic.folder_open, enabled: root.tray_items.length > 0 && !root.is_importing },
                    { id: "skip", label: I18n.tr("Pular / Restaurar"), glyph: Ic.skip_forward, enabled: root.tray_selected_count > 0 && !root.is_importing },
                    { id: "clear", label: I18n.tr("Limpar Fila"), glyph: Ic.brush, enabled: root.tray_items.length > 0 && !root.is_importing },
                ];
                triggered(id) => {
                    if (id == "cc_sel") { root.set_destination_selected(); }
                    if (id == "cc_all") { root.set_destination_all(); }
                    if (id == "skip") { root.skip_selected_clicked(); }
                    if (id == "clear") { root.clear_queue_clicked(); }
                }
            }
            Button {
                text: root.is_importing ? I18n.tr("Processando...") : I18n.tr("Iniciar Importação em Lote");
                icon_str: root.is_importing ? Ic.hourglass : Ic.download;
                kind: ButtonKind.filled;
                enabled: root.tray_items.length > 0 && !root.is_importing;
                clicked => { root.start_import_clicked(); }
            }
        }

        // Ações por item da fila: cada Sim ou Lote pode ter seu próprio destino
        // de CC, e itens indesejados são pulados sem sair da lista.
        HorizontalLayout {
            spacing: 10px;
            Button {
                text: I18n.tr("Destino do CC (selecionados)");
                icon_str: Ic.folder_open;
                enabled: root.tray_selected_count > 0 && !root.is_importing;
                clicked => { root.set_destination_selected(); }
            }
            Button {
                text: I18n.tr("Destino do CC (todos)");
                icon_str: Ic.folder_open;
                enabled: root.tray_items.length > 0 && !root.is_importing;
                clicked => { root.set_destination_all(); }
            }
            Button {
                text: I18n.tr("Pular / Restaurar");
                icon_str: Ic.skip_forward;
                enabled: root.tray_selected_count > 0 && !root.is_importing;
                clicked => { root.skip_selected_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: I18n.tr("Limpar Fila");
                icon_str: Ic.brush;
                enabled: root.tray_items.length > 0 && !root.is_importing;
                clicked => { root.clear_queue_clicked(); }
            }
        }

        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                alignment: start;

                if root.tray_items.length == 0 : Text {
                    text: I18n.tr("Nenhum arquivo de Sim/Lote na fila de importação.");
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for item in root.tray_items : Rectangle {
                    height: 52px;
                    border-radius: 6px;
                    background: item.selected
                        ? Theme.primary_color.transparentize(0.7)
                        : (item_touch.has-hover ? Theme.surface_header : transparent);

                    item_touch := TouchArea {
                        clicked => { root.tray_item_clicked(item.index); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Icon {
                            glyph: item.selected ? Ic.checkbox_on : Ic.checkbox_off;
                            font-size: 14px;
                            color: item.selected ? Theme.accent_color : Theme.text_muted;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                // Um item pulado continua à vista para o usuário
                                // poder voltar atrás antes de confirmar.
                                text: item.name;
                                font-size: 13px;
                                font-weight: 600;
                                color: item.skipped ? Theme.text_muted : Theme.text_primary;
                                overflow: elide;
                            }
                            Text {
                                text: I18n.tr("CC vai para: ") + item.cc_target_label;
                                font-size: 11px;
                                color: Theme.text_muted;
                                overflow: elide;
                            }
                        }
                        Text { text: item.type_str; font-size: 12px; color: Theme.text_secondary; width: 120px; vertical-alignment: center; }
                        Text { text: item.files_count + " " + I18n.tr("arquivos"); font-size: 12px; color: Theme.accent_color; width: 100px; vertical-alignment: center; }
                    }
                }
            }
        }

        StatusBar { text: root.tray_status; }
    }
}
