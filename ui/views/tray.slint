import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";
import { Card } from "../components/card.slint";
import { PrimaryButton } from "../components/button.slint";

export struct TrayItem {
    name: string,
    type_str: string,
    files_count: string,
}

export component TrayView inherits Rectangle {
    in property <[TrayItem]> tray_items;
    in property <bool> is_importing: false;
    in property <string> tray_status: "Arraste zips de Sims/Lotes ou selecione arquivos para importar.";

    callback select_tray_files_clicked();
    callback start_import_clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: I18n.tr("🗂️ Importador de Sims e Lotes (Tray Importer V3)");
            font-size: 22px;
            font-weight: 800;
            color: Theme.text_primary;
        }

        HorizontalLayout {
            spacing: 12px;
            PrimaryButton {
                text: I18n.tr("📁 Selecionar Zips / Arquivos Tray");
                enabled: !root.is_importing;
                clicked => { root.select_tray_files_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            PrimaryButton {
                text: root.is_importing ? I18n.tr("⏳ Processando...") : I18n.tr("📥 Iniciar Importação em Lote");
                enabled: root.tray_items.length > 0 && !root.is_importing;
                btn_color: Theme.primary_color;
                hover_color: Theme.primary_hover;
                clicked => { root.start_import_clicked(); }
            }
        }

        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;

                if root.tray_items.length == 0 : Text {
                    text: I18n.tr("Nenhum arquivo de Sim/Lote na fila de importação.");
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for item in root.tray_items : HorizontalLayout {
                    height: 40px;
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Text { text: "👤 " + item.name; font-size: 13px; font-weight: 600; color: Theme.text_primary; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: item.type_str; font-size: 12px; color: Theme.text_secondary; width: 120px; vertical-alignment: center; }
                    Text { text: item.files_count + " " + I18n.tr("arquivos"); font-size: 12px; color: Theme.accent_color; width: 100px; vertical-alignment: center; }
                }
            }
        }

        Card {
            height: 40px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                Text { text: root.tray_status; font-size: 13px; color: Theme.info; vertical-alignment: center; }
            }
        }
    }
}
