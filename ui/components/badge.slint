import { Theme } from "../palette.slint";

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <color> badge_color: Theme.info;

    height: 24px;
    border-radius: 12px;
    background: badge_color.transparentize(0.8);
    border-color: badge_color;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 700;
            color: badge_color;
            vertical-alignment: center;
        }
    }
}
