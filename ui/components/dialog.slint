import { M3 } from "../theme/colors.slint";
import { Motion } from "../theme/motion.slint";
import { Type, Shape, Elevation, Space } from "../theme/typography.slint";
import { Icon } from "icon.slint";

/// Diálogo modal do Material Design 3.
///
/// Os 8 overlays do app eram o mesmo bloco copiado à mão: um `Rectangle` de 100%×100% com
/// `#000000.transparentize(0.4)`, uma `TouchArea` vazia para barrar cliques e um `Card` no meio.
/// Apareciam e sumiam em um quadro, já na opacidade final.
///
/// **O diálogo fica sempre instanciado.** Se a vista usar `if aberto : Dialog`, não há como animar
/// a saída — o elemento deixa de existir antes do primeiro quadro. Aqui `mounted` mantém o painel
/// vivo durante a animação de fechamento e o esconde no fim, controlado por um `Timer`.
///
/// `@children` não pode ficar sob um `if` (o compilador do Slint recusa), então **conteúdo pesado
/// é responsabilidade do ponto de uso**: o diálogo de detalhes do painel percorre listas de
/// milhares de linhas e precisa envolvê-las no seu próprio `if`, como já faz.
export component Dialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> icon_str: "";
    in property <color> title_color: M3.on_surface;
    in property <length> panel_width: 560px;
    /// Clique fora do painel. A vista decide se isso fecha ou não — uma confirmação destrutiva
    /// não deve sumir por um clique perdido.
    callback dismissed();

    property <bool> mounted: false;

    changed open => {
        if (root.open) {
            root.mounted = true;
            desmontar.running = false;
        } else {
            desmontar.running = true;
        }
    }

    desmontar := Timer {
        interval: Motion.short4;
        running: false;
        triggered => {
            root.mounted = false;
            self.running = false;
        }
    }

    width: 100%;
    height: 100%;
    visible: root.mounted;

    scrim := Rectangle {
        background: M3.scrim;
        opacity: root.open ? M3.scrim_opacity : 0.0;
        animate opacity { duration: Motion.short4; easing: Motion.standard; }

        // Barra cliques no que está atrás. Sem isto dava para acionar um botão da vista através
        // do diálogo.
        TouchArea {
            clicked => { root.dismissed(); }
        }
    }

    painel := Rectangle {
        width: min(root.panel_width, root.width - 48px);
        height: conteudo.preferred-height;
        background: M3.surface_container_high;
        border-radius: Shape.xl;
        border-width: 1px;
        border-color: M3.outline_variant;

        drop-shadow-color: M3.shadow_soft;
        drop-shadow-blur: Elevation.l4;
        drop-shadow-offset-y: 8px;

        opacity: root.open ? 1.0 : 0.0;
        // Sem `transform: scale` em Slint, a entrada vem de um deslocamento curto para cima —
        // suficiente para o diálogo parecer chegar, e não aparecer.
        y: (root.height - self.height) / 2 + (root.open ? 0px : 20px);

        animate opacity {
            duration: root.open ? Motion.medium4 : Motion.short4;
            easing: root.open ? Motion.emphasized_decelerate : Motion.emphasized_accelerate;
        }
        animate y {
            duration: root.open ? Motion.medium4 : Motion.short4;
            easing: root.open ? Motion.emphasized_decelerate : Motion.emphasized_accelerate;
        }

        // Consome cliques no painel para que não cheguem ao scrim e o fechem.
        TouchArea { }

        conteudo := VerticalLayout {
            padding: Space.xxl;
            spacing: Space.lg;

            if root.title != "": HorizontalLayout {
                spacing: Space.md;
                alignment: start;
                if root.icon_str != "": Icon {
                    glyph: root.icon_str;
                    font-size: 22px;
                    color: root.title_color;
                }
                Text {
                    text: root.title;
                    font-size: Type.headline_s;
                    font-weight: Type.headline_s_w;
                    color: root.title_color;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }

            @children
        }
    }
}

/// Linha de ações de um diálogo: alinhada à direita, ação principal por último.
///
/// MD3 põe a ação de confirmação à direita porque é onde o olhar termina a leitura do texto.
export component DialogActions inherits HorizontalLayout {
    spacing: Space.md;
    alignment: end;
    Rectangle { horizontal-stretch: 1; }
    @children
}
