import { Theme } from "../palette.slint";
import { PrimaryButton } from "button.slint";

export component ModalDialog inherits Rectangle {
    in property <string> title: "Aviso";
    in property <bool> is_open: false;
    callback close_clicked();

    visible: is_open;
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // Backdrop
    Rectangle {
        background: #000000.transparentize(0.4);
        TouchArea {
            clicked => { root.close_clicked(); }
        }
    }

    // Container
    Rectangle {
        width: 550px;
        background: Theme.surface;
        border-radius: 14px;
        border-color: Theme.border_color;
        border-width: 1px;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                Text {
                    text: root.title;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    horizontal-stretch: 1;
                }
                PrimaryButton {
                    text: "✕";
                    btn_color: transparent;
                    hover_color: Theme.surface_hover;
                    clicked => { root.close_clicked(); }
                }
            }

            @children

        }
    }
}
