import { I18n } from "../i18n.slint";
import { M3 } from "../theme/colors.slint";
import { Motion } from "../theme/motion.slint";
import { Type, Space } from "../theme/typography.slint";
import { Icon, Ic } from "icon.slint";
import { StateLayer } from "state_layer.slint";

struct NavEntry {
    label: string,
    glyph: string,
}

/// Item da navegação. Não desenha o próprio fundo de "ativo": esse é o indicador único do
/// `Sidebar`, que desliza entre as posições — oito fundos independentes trocando de cor a seco
/// era exatamente o que fazia a navegação parecer estática.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon_str;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked();

    border-radius: root.height / 2;
    background: transparent;

    Rectangle {
        border-radius: parent.border-radius;
        clip: true;
        StateLayer {
            tint: root.active ? M3.on_primary_container : M3.on_surface;
            hovered: touch.has-hover;
            pressed: touch.pressed;
            focused: fs.has-focus;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            fs.focus();
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 18px;
        padding-right: root.collapsed ? 0px : 16px;
        spacing: Space.md;
        alignment: root.collapsed ? center : start;

        Icon {
            glyph: root.icon_str;
            font-size: 20px;
            color: root.active ? M3.on_primary_container : M3.on_surface_variant;
        }

        if !root.collapsed: Text {
            text: root.text;
            font-size: Type.label_l;
            font-weight: root.active ? 700 : Type.label_l_w;
            color: root.active ? M3.on_primary_container : M3.on_surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            animate color { duration: Motion.medium2; easing: Motion.standard; }
        }
    }
}

/// Navigation rail do Material Design 3.
///
/// O indicador ativo é uma pílula única que **desliza** até o item escolhido, em vez de oito
/// retângulos acendendo e apagando. Um `animate y` resolve, e é a mudança de maior retorno por
/// linha de toda a refatoração: a navegação passa a ter continuidade em vez de piscar.
///
/// A posição é calculada, não empilhada por layout, porque o indicador precisa saber a coordenada
/// exata de cada item para animar até ela — um `VerticalLayout` não expõe isso.
export component Sidebar inherits Rectangle {
    in-out property <int> current_tab: 0;
    /// Numa janela estreita a rail encolhe para só ícones (ver `main.slint`).
    in property <bool> collapsed: false;
    callback tab_changed(int);

    property <length> item_h: 48px;
    property <length> gap: 8px;
    property <length> pitch: self.item_h + self.gap;
    property <length> header_h: 92px;

    property <[NavEntry]> entries: [
        { label: I18n.tr("Início"), glyph: Ic.home },
        { label: I18n.tr("Instalador"), glyph: Ic.package },
        { label: I18n.tr("Organizador"), glyph: Ic.folder_open },
        { label: I18n.tr("Merger"), glyph: Ic.link },
        { label: I18n.tr("Tray Importer"), glyph: Ic.inbox },
        { label: I18n.tr("Traduções"), glyph: Ic.language },
        { label: I18n.tr("ReShade"), glyph: Ic.sparkles },
        { label: I18n.tr("Configurações"), glyph: Ic.settings },
    ];

    width: root.collapsed ? 76px : 240px;
    background: M3.surface_container_low;
    animate width, background { duration: Motion.medium2; easing: Motion.emphasized; }

    HorizontalLayout {
        y: 16px;
        height: 60px;
        padding-left: root.collapsed ? 0px : 16px;
        spacing: 10px;
        alignment: root.collapsed ? center : start;

        Icon {
            glyph: Ic.diamond;
            font-size: 26px;
            color: M3.primary;
        }

        if !root.collapsed: VerticalLayout {
            alignment: center;
            Text {
                text: "S4Suite";
                font-size: Type.title_l;
                font-weight: 800;
                color: M3.on_surface;
                animate color { duration: Motion.medium2; easing: Motion.standard; }
            }
            Text {
                text: I18n.tr("Linux Edition v2.0");
                font-size: Type.label_s;
                color: M3.primary;
                animate color { duration: Motion.medium2; easing: Motion.standard; }
            }
        }
    }

    // Pílula do item ativo — a peça que desliza.
    Rectangle {
        x: 12px;
        y: root.header_h + root.current_tab * root.pitch;
        width: root.width - 24px;
        height: root.item_h;
        border-radius: root.item_h / 2;
        background: M3.primary_container;

        animate y { duration: Motion.medium2; easing: Motion.emphasized; }
        animate background, width { duration: Motion.medium2; easing: Motion.standard; }
    }

    for entry[i] in root.entries: NavItem {
        x: 12px;
        y: root.header_h + i * root.pitch;
        width: root.width - 24px;
        height: root.item_h;
        text: entry.label;
        icon_str: entry.glyph;
        active: root.current_tab == i;
        collapsed: root.collapsed;
        clicked => {
            root.current_tab = i;
            root.tab_changed(i);
        }
    }

    if !root.collapsed: Text {
        y: root.height - 32px;
        width: root.width;
        text: I18n.tr("Rust + Slint Native");
        font-size: Type.label_s;
        color: M3.outline;
        horizontal-alignment: center;
    }
}
