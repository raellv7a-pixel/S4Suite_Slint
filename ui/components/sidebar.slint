import { I18n } from "../i18n.slint";
import { Theme } from "../palette.slint";

export component SidebarItem inherits Rectangle {
    in property <string> text;
    in property <string> icon_str;
    in property <bool> active: false;
    callback clicked();

    height: 48px;
    border-radius: 8px;
    background: active ? Theme.primary_color : (touch.has-hover ? Theme.surface_hover : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        Text {
            text: root.icon_str;
            font-size: 18px;
            color: active ? #ffffff : Theme.text_secondary;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 14px;
            font-weight: active ? 700 : 500;
            color: active ? #ffffff : Theme.text_primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <int> current_tab: 0;
    callback tab_changed(int);

    width: 240px;
    background: Theme.surface;
    border-color: Theme.border_color;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        // Header / Logo
        Rectangle {
            height: 60px;
            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: "💎";
                    font-size: 26px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: I18n.tr("S4Suite");
                        font-size: 20px;
                        font-weight: 800;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: I18n.tr("Linux Edition v2.0");
                        font-size: 11px;
                        color: Theme.accent_color;
                    }
                }
            }
        }

        Rectangle { height: 12px; }

        SidebarItem {
            text: I18n.tr("Início");
            icon_str: "🏠";
            active: current_tab == 0;
            clicked => { current_tab = 0; root.tab_changed(0); }
        }
        SidebarItem {
            text: I18n.tr("Instalador");
            icon_str: "📦";
            active: current_tab == 1;
            clicked => { current_tab = 1; root.tab_changed(1); }
        }
        SidebarItem {
            text: I18n.tr("Organizador");
            icon_str: "📂";
            active: current_tab == 2;
            clicked => { current_tab = 2; root.tab_changed(2); }
        }
        SidebarItem {
            text: I18n.tr("Merger");
            icon_str: "🔗";
            active: current_tab == 3;
            clicked => { current_tab = 3; root.tab_changed(3); }
        }
        SidebarItem {
            text: I18n.tr("Tray Importer");
            icon_str: "🗂️";
            active: current_tab == 4;
            clicked => { current_tab = 4; root.tab_changed(4); }
        }
        SidebarItem {
            text: I18n.tr("Traduções");
            icon_str: "🌐";
            active: current_tab == 5;
            clicked => { current_tab = 5; root.tab_changed(5); }
        }
        SidebarItem {
            text: I18n.tr("ReShade");
            icon_str: "🔮";
            active: current_tab == 6;
            clicked => { current_tab = 6; root.tab_changed(6); }
        }
        SidebarItem {
            text: I18n.tr("Configurações");
            icon_str: "⚙️";
            active: current_tab == 7;
            clicked => { current_tab = 7; root.tab_changed(7); }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: I18n.tr("Rust + Slint Native");
            font-size: 11px;
            color: Theme.text_muted;
            horizontal-alignment: center;
        }
    }
}
