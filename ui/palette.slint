import { M3 } from "theme/colors.slint";

export { M3 }

// Camada de compatibilidade: os nomes antigos (`surface_header`, `text_muted`, …) continuam
// funcionando enquanto as 9 views migram para os papéis do `M3`, uma de cada vez. Cada token aqui
// é só um apelido — mudar uma cor significa mudar o papel correspondente no `M3`, nunca aqui.
//
// Este global some quando a última view parar de usá-lo.
export global Theme {
    // Mantido porque `src/bridge/slint_adapter.rs` grava o índice do tema aqui e
    // `ui/views/config.slint` lê para marcar o chip ativo.
    in-out property <int> active_theme: 0;

    out property <color> primary_color: M3.primary_container;
    out property <color> primary_hover: M3.primary_container.brighter(0.18);
    out property <color> accent_color: M3.primary;

    out property <color> background: M3.surface;
    out property <color> surface: M3.surface_container;
    out property <color> surface_header: M3.surface_container_high;
    out property <color> surface_hover: M3.surface_container_highest;
    out property <color> border_color: M3.outline_variant;

    out property <color> text_primary: M3.on_surface;
    out property <color> text_secondary: M3.on_surface_variant;
    out property <color> text_muted: M3.outline;

    out property <color> success: M3.tertiary;
    out property <color> warning: M3.warning;
    out property <color> danger: M3.error;
    out property <color> info: M3.info;
}
